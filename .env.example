# Copy to .env and change the values. docker compose picks .env up automatically;
# without it the compose file falls back to the same dev-only placeholders.
# Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wallet

# --- Shared between the two services ---
# wallet-service -> provider-mock: Authorization: Bearer <PROVIDER_API_KEY>
PROVIDER_API_KEY=change-me-provider-api-key
# provider-mock -> wallet-service: HMAC-SHA256 secret for X-Signature
PROVIDER_WEBHOOK_SECRET=change-me-webhook-secret

# --- wallet-service ---
PROVIDER_CONNECT_TIMEOUT_SECONDS=2
PROVIDER_READ_TIMEOUT_SECONDS=5
WEBHOOK_TOLERANCE_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# --- host ports ---
WALLET_PORT=8000
PROVIDER_PORT=8001
